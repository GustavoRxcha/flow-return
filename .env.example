# Copie para .env e preencha. O .env nunca vai para o código, telas ou registros.

# IA da atendente. Com AI_API_KEY, usa a IA por API. Sem chave, usa o Ollama no próprio computador.
# AI_PROVIDER: gemini (padrão) ou openai. Outra IA no formato de chat da OpenAI: preencha AI_BASE_URL.
AI_PROVIDER=gemini
AI_API_KEY=
# Opcional. Sem valor, usa o modelo padrão do provedor (server/ai.ts).
AI_MODEL=
AI_BASE_URL=

# Dados do painel da Meta, em WhatsApp > Configuração da API.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Chave secreta do app, em Configurações do app > Básico.
WHATSAPP_APP_SECRET=
# Palavra combinada com a Meta. Qualquer texto longo serve.
WHATSAPP_VERIFY_TOKEN=
# Nome do negócio que atende por este número.
WHATSAPP_NEGOCIO="Barbearia do Bigode"
