# Copie para .env e preencha. O .env nunca vai para o código, telas ou registros.

# Dados do painel da Meta, em WhatsApp > Configuração da API.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Chave secreta do app, em Configurações do app > Básico.
WHATSAPP_APP_SECRET=
# Palavra combinada com a Meta. Qualquer texto longo serve.
WHATSAPP_VERIFY_TOKEN=
# Nome do negócio que atende por este número.
WHATSAPP_NEGOCIO="Barbearia do Bigode"
